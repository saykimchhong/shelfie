# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# These are public by design; Firestore security rules are what protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Public URL of the deployed app (used for share links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. "mock" = sample products, no AI calls (default, free).
# "gemini" = real video extraction; needs GEMINI_API_KEY.
SHELFIE_AI=mock

# Server only — Google AI Studio key for the Gemini API.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3-flash-preview.
GEMINI_MODEL=
