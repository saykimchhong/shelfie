rules_version = '2';

// Shelfie photos (src/features/media/storage.ts):
//   sellers/{uid}/stores/{slug}/{products|logo}/{file}
// - Anyone can read: photos appear on public stores.
// - Only the signed-in seller can write under their own uid: small images only.
// Everything else in the bucket is closed.

service firebase.storage {
  match /b/{bucket}/o {
    match /sellers/{uid}/stores/{slug}/{folder}/{file} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if true;

      allow create, update: if isOwner()
        && folder in ['products', 'logo']
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');

      allow delete: if isOwner();
    }
  }
}
